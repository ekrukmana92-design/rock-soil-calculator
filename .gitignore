# ---------------------------------------------------------------------------
# File/folder yang TIDAK perlu diunggah ke GitHub
# ---------------------------------------------------------------------------

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Kivy
.kivy/
*.pyc

# Buildozer (hasil build lokal — besar, tidak perlu di-commit)
.buildozer/
bin/
*.apk
*.aab

# Database lokal (dibuat otomatis saat aplikasi dijalankan)
data/*.db
data/*.db-shm
data/*.db-wal
*.db
*.db-shm
*.db-wal

# Backup yang dihasilkan aplikasi
backup/
*.backup.json

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Log
*.log
